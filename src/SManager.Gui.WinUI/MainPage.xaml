<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="PaginaPrincipal"
    x:Class="SManager.Gui.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SManager.Gui.WinUI.Models"
    xmlns:conv="using:SManager.Gui.WinUI.Convertidores"
    xmlns:vistas="using:SManager.Gui.WinUI.Vistas"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="AtajoGuardar_Invoked"
            ToolTipService.ToolTip="Guardar configuración (Ctrl+S)" />
        <KeyboardAccelerator
            Key="F5"
            Invoked="AtajoRecargar_Invoked"
            ToolTipService.ToolTip="Recargar demonio (F5)" />
        <KeyboardAccelerator
            Key="I"
            Modifiers="Control"
            Invoked="AtajoIniciar_Invoked"
            ToolTipService.ToolTip="Iniciar sincronización (Ctrl+I)" />
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control,Shift"
            Invoked="AtajoDetener_Invoked"
            ToolTipService.ToolTip="Detener demonio (Ctrl+Shift+S)" />
        <KeyboardAccelerator
            Key="A"
            Modifiers="Control,Shift"
            Invoked="AtajoAnalizar_Invoked"
            ToolTipService.ToolTip="Analizar cambios (Ctrl+Shift+A)" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <conv:BooleanoAVisibilidadConvertidor x:Key="BoolAVis" />
        <conv:NivelRegistroBrushConvertidor x:Key="NivelRegistroBrush" />
        <conv:EstadoParBrushConvertidor x:Key="EstadoParBrush" />
        <conv:AnchoColumnaPxConvertidor x:Key="AnchoColumnaPx" />
        <Style x:Key="CabeceraColumna" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CeldaFila" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTipService.ToolTip" Value="{Binding Text}" />
        </Style>
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SubtituloSeccion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="EtiquetaGrupo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="BotonExaminarCarpeta" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ToolTip" Value="Examinar carpeta" />
        </Style>
        <Style x:Key="ChipEstado" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="EtiquetaMetrica" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ValorMetrica" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Listas del monitor: ocupan el alto del panel y permiten scroll vertical -->
        <Style x:Key="ListaMonitor" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="False" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        </Style>
        <Style x:Key="SeparadorMonitor" TargetType="Border">
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!-- Separador vertical entre columnas redimensionables (Registro / Monitor) -->
        <Style x:Key="SeparadorColumna" TargetType="Border">
            <Setter Property="Width" Value="6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <NavigationView
        x:Name="NavPrincipal"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        SelectionChanged="NavPrincipal_SelectionChanged">

        <!-- Perfil en el panel lateral -->
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,16,12,8" Spacing="8">
                <TextBlock
                    Text="Perfil activo"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Perfiles, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PerfilSeleccionado, Mode=TwoWay}"
                    SelectionChanged="Perfil_SelectionChanged" />
                <Button
                    HorizontalAlignment="Stretch"
                    Content="Nuevo perfil"
                    Command="{x:Bind ViewModel.NuevoPerfilCommand}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.EliminarPerfilCommand}"
                    IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}"
                    ToolTipService.ToolTip="Borra el perfil activo y sus datos locales (requiere demonio detenido)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Text="Eliminar perfil" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Inicio" Tag="inicio">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Sincronización" Tag="pares">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Sync" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NavMonitor"
                Content="Monitor"
                Tag="monitor"
                Visibility="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="View" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NavRegistro"
                Content="Registro"
                Tag="registro"
                Visibility="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NavEstadisticas"
                Content="Estadísticas"
                Tag="estadisticas"
                Visibility="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="ViewAll" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Guía" Tag="guia">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Contenido principal -->
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de acciones del demonio -->
            <Border
                Grid.Row="0"
                Padding="20,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            AutomationProperties.Name="{x:Bind ViewModel.TextoEstadoAccesible, Mode=OneWay}"
                            AutomationProperties.LiveSetting="Polite">
                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ColorEstado, Mode=OneWay}"
                                AutomationProperties.Name="Indicador de estado" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.TextoEstado, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TextoRutaConfiguracionBarra, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RutaConfiguracion, Mode=OneWay}" />
                    </StackPanel>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Auto"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="BotonIniciarSync"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BotonIniciar_Click"
                                IsEnabled="{x:Bind ViewModel.PuedeIniciar, Mode=OneWay}"
                                AutomationProperties.Name="Iniciar sincronización"
                                ToolTipService.ToolTip="Iniciar sincronización (Ctrl+I)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Iniciar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Click="BotonDetener_Click"
                                IsEnabled="{x:Bind ViewModel.PuedeDetener, Mode=OneWay}"
                                AutomationProperties.Name="Detener sincronización"
                                ToolTipService.ToolTip="Detener demonio (Ctrl+Shift+S)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Stop" />
                                    <TextBlock Text="Detener" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Click="BotonRecargar_Click"
                                IsEnabled="{x:Bind ViewModel.PuedeDetener, Mode=OneWay}"
                                ToolTipService.ToolTip="Recargar configuración en el demonio (F5)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="Recargar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BotonAnalizarCambios"
                                Command="{x:Bind ViewModel.AnalizarCambiosCommand}"
                                IsEnabled="{x:Bind ViewModel.PuedeAnalizarCambios, Mode=OneWay}"
                                AutomationProperties.Name="Analizar cambios"
                                ToolTipService.ToolTip="Comparar origen y destino sin copiar archivos (Ctrl+Shift+A)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Find" />
                                    <TextBlock Text="Analizar cambios" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.AnalizandoCambios, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.AnalizandoCambios, Mode=OneWay, Converter={StaticResource BoolAVis}}" />
                            <Button
                                Command="{x:Bind ViewModel.GuardarCommand}"
                                IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}"
                                ToolTipService.ToolTip="Guardar JSON del perfil (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Guardar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Aviso cuando el demonio bloquea la edición -->
            <InfoBar
                Grid.Row="1"
                Title="Sincronización activa"
                Message="La configuración está bloqueada mientras el demonio corre. Los cambios en la interfaz requieren Guardar; los hechos fuera de la app (editar el JSON a mano) requieren Recargar."
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.DemonioEnEjecucion, Mode=OneWay}"
                IsClosable="False" />

            <Grid Grid.Row="2" Padding="20,16">

                <!-- INICIO -->
                <ScrollViewer
                    x:Name="PanelInicio"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="900">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource TituloSeccion}" Text="Panel de control" />
                            <TextBlock
                                Style="{StaticResource SubtituloSeccion}"
                                Text="Estado de la sincronización unidireccional (origen → destino) y accesos rápidos." />
                        </StackPanel>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.TextoDashboardPerfil, Mode=OneWay}" />
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Estado" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse
                                                Width="10"
                                                Height="10"
                                                VerticalAlignment="Center"
                                                Fill="{x:Bind ViewModel.ColorEstado, Mode=OneWay}" />
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.TextoEstado, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Progreso actual" />
                                        <TextBlock Style="{StaticResource ValorMetrica}" FontSize="16" Text="{x:Bind ViewModel.TextoDashboardProgreso, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Archivo actual" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.TextoArchivoActual, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.TextoArchivoActual, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.TextoColaHumana, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.TextoPolling, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="Origen y destino" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TextoDashboardOrigenDestino, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    IsTextSelectionEnabled="True" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Última actividad" />
                                        <TextBlock Text="{x:Bind ViewModel.TextoUltimaSyncCorrecta, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Errores / copiados" />
                                        <TextBlock Text="{x:Bind ViewModel.TextoErroresResumen, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.TextoArchivosCopiadosSesion, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="Acciones rápidas" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.AbrirAsistenteOnboardingCommand}" Content="Asistente de configuración" />
                                    <Button Command="{x:Bind ViewModel.AnalizarCambiosCommand}" Content="Analizar cambios" />
                                    <Button Click="IrASincronizacion_Click" Content="Ir a sincronización" />
                                    <Button Click="IrAMonitor_Click" Content="Ver monitor" />
                                    <Button Click="IrAGuia_Click" Content="Abrir guía" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="Primeros pasos" />
                                <TextBlock Text="1. Define carpetas origen y destino en Sincronización." />
                                <TextBlock Text="2. Pulsa Analizar cambios para ver qué se copiaría sin modificar nada." />
                                <TextBlock Text="3. Guarda el perfil y pulsa Iniciar." />
                                <TextBlock Text="4. Sigue el progreso aquí, en Monitor y en Registro." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SINCRONIZACIÓN (PARES) -->
                <Grid
                    x:Name="PanelPares"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Pares de sincronización" />
                        <TextBlock
                            Style="{StaticResource SubtituloSeccion}"
                            Text="Cada tarjeta es un par origen → destino. Usa Editar para cambiar rutas y filtros." />
                    </StackPanel>

                    <CommandBar
                        Grid.Row="1"
                        DefaultLabelPosition="Right"
                        Background="Transparent">
                        <AppBarButton
                            Icon="Add"
                            Label="Nuevo par"
                            Command="{x:Bind ViewModel.AnadirParCommand}" />
                        <AppBarSeparator />
                        <AppBarButton
                            Icon="Play"
                            Label="Arrancar seleccionados"
                            Command="{x:Bind ViewModel.ArrancarSeleccionadosCommand}"
                            ToolTipService.ToolTip="Inicia sólo los pares marcados con casilla" />
                        <AppBarButton
                            Icon="Pause"
                            Label="Pausar seleccionados"
                            Command="{x:Bind ViewModel.PausarSeleccionadosCommand}"
                            ToolTipService.ToolTip="Pausa los pares marcados con casilla" />
                        <AppBarButton
                            Icon="SelectAll"
                            Label="Seleccionar todos"
                            Command="{x:Bind ViewModel.SeleccionarTodosParesCommand}" />
                        <AppBarSeparator />
                        <AppBarButton
                            Icon="Permissions"
                            Label="Desbloquear borrado (Admin)"
                            Command="{x:Bind ViewModel.DesbloquearBorradoAdminCommand}"
                            ToolTipService.ToolTip="Muestra el cuadro nativo de credenciales de Windows para autorizar borrado en origen" />
                        <AppBarSeparator />
                        <AppBarButton
                            Icon="Accept"
                            Label="Validar rutas"
                            Command="{x:Bind ViewModel.ValidarRutasCommand}" />
                        <AppBarSeparator />
                        <AppBarButton
                            Icon="Refresh"
                            Label="Actualizar tamaños"
                            Command="{x:Bind ViewModel.ActualizarTamanosDestinoCommand}"
                            ToolTipService.ToolTip="Recalcula el tamaño en disco de cada carpeta destino" />
                    </CommandBar>

                    <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="12">
                        <Grid>
                            <!-- Estado vacío -->
                            <StackPanel
                                Padding="32,48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.MostrarEstadoVacioPares, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="40"
                                    Glyph="&#xE8F1;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Todavía no tienes pares de sincronización" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Crea un perfil para copiar automáticamente archivos desde una carpeta origen hacia una carpeta destino."
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Command="{x:Bind ViewModel.AnadirParCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="Crear mi primer par" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Tarjetas de pares -->
                            <ScrollViewer
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.MostrarEstadoVacioPares, Mode=OneWay, Converter={StaticResource BoolAVis}, ConverterParameter=Invertir}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pares, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <DataTemplate x:DataType="models:ParFilaViewModel">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                            <StackPanel Spacing="12">
                                                <!-- Cabecera de tarjeta -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <CheckBox
                                                                IsChecked="{x:Bind Seleccionado, Mode=TwoWay}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,4,0"
                                                                ToolTipService.ToolTip="Marcar para arrancar/pausar en conjunto" />
                                                            <TextBlock
                                                                FontSize="16"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                Text="{x:Bind Nombre, Mode=OneWay}" />
                                                            <Border
                                                                Style="{StaticResource ChipEstado}"
                                                                VerticalAlignment="Center"
                                                                Background="{x:Bind ClaveEstadoChip, Mode=OneWay, Converter={StaticResource EstadoParBrush}, ConverterParameter=Fondo}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{x:Bind ClaveEstadoChip, Mode=OneWay, Converter={StaticResource EstadoParBrush}, ConverterParameter=Texto}"
                                                                    Text="{x:Bind EtiquetaEstadoActividad, Mode=OneWay}" />
                                                            </Border>
                                                            <Border
                                                                Style="{StaticResource ChipEstado}"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind EtiquetaModoSincronizacion, Mode=OneWay}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6" Margin="0,4,0,0">
                                                            <Border
                                                                Background="{StaticResource OrigenFondoBrush}"
                                                                BorderBrush="{StaticResource OrigenAcentoBrush}"
                                                                BorderThickness="0,0,0,2"
                                                                CornerRadius="4"
                                                                Padding="8,6">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource OrigenAcentoBrush}"
                                                                        Text="Origen" />
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Text="{x:Bind RutaOrigen, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTipService.ToolTip="{x:Bind RutaOrigen, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <FontIcon
                                                                HorizontalAlignment="Center"
                                                                FontSize="12"
                                                                Glyph="&#xE74B;"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Border
                                                                Background="{StaticResource DestinoFondoBrush}"
                                                                BorderBrush="{StaticResource DestinoAcentoBrush}"
                                                                BorderThickness="0,0,0,2"
                                                                CornerRadius="4"
                                                                Padding="8,6">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource DestinoAcentoBrush}"
                                                                        Text="Destino" />
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Text="{x:Bind RutaDestino, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTipService.ToolTip="{x:Bind RutaDestino, Mode=OneWay}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind TamanoDestinoTexto, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <InfoBar
                                                            Margin="0,4,0,0"
                                                            IsClosable="False"
                                                            IsOpen="{x:Bind TieneAvisosRiesgo, Mode=OneWay}"
                                                            Message="{x:Bind TextoPrimerAviso, Mode=OneWay}"
                                                            Severity="Warning"
                                                            Title="Aviso de configuración" />
                                                        <InfoBar
                                                            Margin="0,4,0,0"
                                                            IsClosable="False"
                                                            IsOpen="{x:Bind TienePurgaMasivaBloqueada, Mode=OneWay}"
                                                            Message="{x:Bind TextoAlertaPurgaMasiva, Mode=OneWay}"
                                                            Severity="Error"
                                                            Title="Purga Masiva Detenida">
                                                            <InfoBar.ActionButton>
                                                                <Button
                                                                    Content="Autorizar Purga Masiva"
                                                                    Command="{Binding DataContext.AutorizarPurgaMasivaCommand, ElementName=PaginaPrincipal}"
                                                                    CommandParameter="{x:Bind}" />
                                                            </InfoBar.ActionButton>
                                                        </InfoBar>
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                        <Button
                                                            Padding="8"
                                                            ToolTipService.ToolTip="Expandir detalles"
                                                            Command="{x:Bind AlternarExpansionCommand}">
                                                            <FontIcon Glyph="{x:Bind GlifoExpansion, Mode=OneWay}" />
                                                        </Button>
                                                        <Button
                                                            Padding="8"
                                                            ToolTipService.ToolTip="Editar par"
                                                            Command="{Binding DataContext.EditarParCommand, ElementName=PaginaPrincipal}"
                                                            CommandParameter="{x:Bind}"
                                                            IsEnabled="{Binding DataContext.PuedeEditarConfig, ElementName=PaginaPrincipal}">
                                                            <SymbolIcon Symbol="Edit" />
                                                        </Button>
                                                        <Button
                                                            Padding="8"
                                                            ToolTipService.ToolTip="Eliminar par"
                                                            Command="{Binding DataContext.QuitarParCommand, ElementName=PaginaPrincipal}"
                                                            CommandParameter="{x:Bind}"
                                                            IsEnabled="{Binding DataContext.PuedeEditarConfig, ElementName=PaginaPrincipal}">
                                                            <SymbolIcon Symbol="Delete" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Detalle expandible (solo lectura; editar abre diálogo) -->
                                                <StackPanel
                                                    Spacing="8"
                                                    Visibility="{x:Bind Expandido, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                                                    <Border
                                                        Background="{StaticResource OrigenFondoBrush}"
                                                        CornerRadius="4"
                                                        Padding="10,8">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource OrigenAcentoBrush}" Text="Carpeta origen" />
                                                            <TextBlock
                                                                IsTextSelectionEnabled="True"
                                                                Text="{x:Bind RutaOrigen, Mode=OneWay}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border
                                                        Background="{StaticResource DestinoFondoBrush}"
                                                        CornerRadius="4"
                                                        Padding="10,8">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource DestinoAcentoBrush}" Text="Carpeta destino" />
                                                            <TextBlock
                                                                IsTextSelectionEnabled="True"
                                                                Text="{x:Bind RutaDestino, Mode=OneWay}"
                                                                TextWrapping="WrapWholeWords" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind TamanoDestinoTexto, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <TextBlock FontWeight="SemiBold" Text="Incluir" />
                                                            <TextBlock
                                                                FontFamily="Consolas"
                                                                FontSize="12"
                                                                Text="{x:Bind FiltroInclusion, Mode=OneWay}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock FontWeight="SemiBold" Text="Excluir" />
                                                            <TextBlock
                                                                FontFamily="Consolas"
                                                                FontSize="12"
                                                                Text="{x:Bind FiltroExclusion, Mode=OneWay}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MONITOR: tres paneles apilados con separadores redimensionables y scroll en cada lista -->
                <Grid
                    x:Name="PanelMonitor"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="FilaMonitorPares" Height="1.1*" MinHeight="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="FilaMonitorCopias" Height="*" MinHeight="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="FilaMonitorActividad" Height="1.4*" MinHeight="72" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource TituloSeccion}" Text="Monitor en tiempo real" />
                            <TextBlock
                                Style="{StaticResource SubtituloSeccion}"
                                Text="Arrastra las barras entre paneles para cambiar su altura. Cada lista tiene scroll vertical independiente (rueda del ratón o barra lateral)." />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Spacing="8">
                            <Button
                                Click="ExportarParesActivos_Click"
                                ToolTipService.ToolTip="Guarda una imagen PNG o JPG de los pares en estado OK">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Camera" />
                                    <TextBlock Text="Exportar imagen" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Panel: estado por par -->
                    <Grid Grid.Row="1" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource EtiquetaGrupo}" Margin="0,0,0,0" Text="Estado por par" />
                        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    x:Name="CabeceraMonitorPares"
                                    ColumnSpacing="0"
                                    Padding="8,6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            x:Name="ColMonitorNombre"
                                            Width="{x:Bind ViewModel.AnchoMonitorNombre, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition
                                            x:Name="ColMonitorEstado"
                                            Width="{x:Bind ViewModel.AnchoMonitorEstado, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition
                                            x:Name="ColMonitorTamanoDestino"
                                            Width="{x:Bind ViewModel.AnchoMonitorTamanoDestino, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition
                                            x:Name="ColMonitorCopiados"
                                            Width="{x:Bind ViewModel.AnchoMonitorCopiados, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition
                                            x:Name="ColMonitorErrores"
                                            Width="{x:Bind ViewModel.AnchoMonitorErrores, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource CabeceraColumna}" Text="Nombre" />
                                    <Border
                                        x:Name="SepMonitorNombreEstado"
                                        Grid.Column="1"
                                        Style="{StaticResource SeparadorColumna}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource CabeceraColumna}" Text="Estado" />
                                    <Border
                                        x:Name="SepMonitorEstadoTamano"
                                        Grid.Column="3"
                                        Style="{StaticResource SeparadorColumna}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource CabeceraColumna}" Text="Tamaño destino" />
                                    <Border
                                        x:Name="SepMonitorTamanoCopiados"
                                        Grid.Column="5"
                                        Style="{StaticResource SeparadorColumna}" />
                                    <TextBlock Grid.Column="6" Style="{StaticResource CabeceraColumna}" Text="Copiados" />
                                    <Border
                                        x:Name="SepMonitorCopiadosErrores"
                                        Grid.Column="7"
                                        Style="{StaticResource SeparadorColumna}" />
                                    <TextBlock Grid.Column="8" Style="{StaticResource CabeceraColumna}" Text="Errores" />
                                </Grid>
                                <ListView
                                    x:Name="ListaMonitorPares"
                                    Grid.Row="1"
                                    Style="{StaticResource ListaMonitor}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ItemsSource="{x:Bind ViewModel.MonitorPares, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MonitorParViewModel">
                                            <Grid ColumnSpacing="0" Padding="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoMonitorNombre, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoMonitorEstado, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoMonitorTamanoDestino, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoMonitorCopiados, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoMonitorErrores, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{StaticResource CeldaFila}"
                                                    Text="{x:Bind Nombre}"
                                                    ToolTipService.ToolTip="{x:Bind Nombre}" />
                                                <Border
                                                    Grid.Column="2"
                                                    Style="{StaticResource ChipEstado}"
                                                    Background="{x:Bind Estado, Mode=OneWay, Converter={StaticResource EstadoParBrush}, ConverterParameter=Fondo}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{x:Bind Estado, Mode=OneWay, Converter={StaticResource EstadoParBrush}, ConverterParameter=Texto}"
                                                        Text="{x:Bind Estado}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="4"
                                                    Style="{StaticResource CeldaFila}"
                                                    Text="{x:Bind TamanoDestinoTexto}"
                                                    ToolTipService.ToolTip="{x:Bind RutaDestino}" />
                                                <TextBlock Grid.Column="6" Style="{StaticResource CeldaFila}" Text="{x:Bind Copiados}" />
                                                <TextBlock Grid.Column="8" Style="{StaticResource CeldaFila}" Text="{x:Bind Errores}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        x:Name="SeparadorMonitorSuperior"
                        Grid.Row="2"
                        Style="{StaticResource SeparadorMonitor}" />

                    <!-- Panel: copias en curso -->
                    <Grid Grid.Row="3" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource EtiquetaGrupo}" Margin="0,0,0,0" Text="Copiando ahora" />
                        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    ColumnSpacing="8"
                                    Padding="8,6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource CabeceraColumna}" Text="Copiador" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CabeceraColumna}" Text="Archivo" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource CabeceraColumna}" Text="Progreso" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource CabeceraColumna}" Text="ETA" />
                                </Grid>
                                <ListView
                                    x:Name="ListaMonitorCopias"
                                    Grid.Row="1"
                                    Style="{StaticResource ListaMonitor}"
                                    ItemsSource="{x:Bind ViewModel.CopiasEnCurso, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CopiaEnCursoViewModel">
                                            <StackPanel Spacing="4" Padding="8,6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource CeldaFila}" Text="{x:Bind Copiador}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource CeldaFila}"
                                                        Text="{x:Bind Archivo}"
                                                        TextWrapping="NoWrap"
                                                        ToolTipService.ToolTip="{x:Bind Archivo}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource CeldaFila}" Text="{x:Bind TextoProgreso}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Style="{StaticResource CeldaFila}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind TextoEta}" />
                                                </Grid>
                                                <ProgressBar
                                                    Maximum="100"
                                                    Value="{x:Bind ValorProgreso}"
                                                    Visibility="{x:Bind MostrarBarraProgreso, Converter={StaticResource BoolAVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        x:Name="SeparadorMonitorInferior"
                        Grid.Row="4"
                        Style="{StaticResource SeparadorMonitor}" />

                    <!-- Panel: actividad reciente -->
                    <Grid Grid.Row="5" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource EtiquetaGrupo}" Margin="0,0,0,0" Text="Actividad reciente" />
                        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    ColumnSpacing="8"
                                    Padding="8,6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource CabeceraColumna}" Text="Hora" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CabeceraColumna}" Text="Tipo" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource CabeceraColumna}" Text="Archivo" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource CabeceraColumna}" Text="Par" />
                                </Grid>
                                <ListView
                                    x:Name="ListaMonitorActividad"
                                    Grid.Row="1"
                                    Style="{StaticResource ListaMonitor}"
                                    ItemsSource="{x:Bind ViewModel.ActividadReciente, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActividadViewModel">
                                            <Grid ColumnSpacing="8" Padding="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource CeldaFila}" Text="{x:Bind Hora}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource CeldaFila}" Text="{x:Bind Tipo}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{StaticResource CeldaFila}"
                                                    Text="{x:Bind Archivo}"
                                                    ToolTipService.ToolTip="{x:Bind Archivo}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Style="{StaticResource CeldaFila}"
                                                    Text="{x:Bind NombrePar}"
                                                    ToolTipService.ToolTip="{x:Bind NombrePar}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- REGISTRO -->
                <Grid x:Name="PanelRegistro" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Registro del demonio" />
                        <TextBlock
                            Style="{StaticResource SubtituloSeccion}"
                            Text="Líneas coloreadas por nivel. Filtra por par, severidad o texto libre." />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Par:" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.FiltrosParRegistro, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.ParFiltroRegistroSeleccionado, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="Nivel:" />
                        <ComboBox
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.FiltrosNivelRegistro, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.NivelFiltroRegistroSeleccionado, Mode=TwoWay}" />
                        <AutoSuggestBox
                            Grid.Column="4"
                            PlaceholderText="Buscar en el registro…"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.TextoBusquedaRegistro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Filtro rápido:" />
                            <Button
                                Command="{x:Bind ViewModel.AplicarFiltroRegistroRapidoCommand}"
                                CommandParameter=""
                                Content="Todos"
                                ToolTipService.ToolTip="Mostrar todos los niveles" />
                            <Button
                                Command="{x:Bind ViewModel.AplicarFiltroRegistroRapidoCommand}"
                                CommandParameter="ERROR"
                                Content="Errores"
                                ToolTipService.ToolTip="Solo líneas ERROR" />
                            <Button
                                Command="{x:Bind ViewModel.AplicarFiltroRegistroRapidoCommand}"
                                CommandParameter="WARN"
                                Content="Advertencias"
                                ToolTipService.ToolTip="Solo líneas WARN" />
                            <Button
                                Command="{x:Bind ViewModel.AplicarFiltroRegistroRapidoCommand}"
                                CommandParameter="INFO"
                                Content="Info"
                                ToolTipService.ToolTip="Solo líneas INFO" />
                            <Button
                                Command="{x:Bind ViewModel.AplicarFiltroRegistroRapidoCommand}"
                                CommandParameter="PENDIENTE"
                                Content="Pendiente"
                                ToolTipService.ToolTip="Solo líneas PENDIENTE" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.ExportarRegistroCommand}"
                                ToolTipService.ToolTip="Guarda las líneas visibles en Descargas">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Exportar registro" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.ExportarDiagnosticoCommand}"
                                ToolTipService.ToolTip="Paquete de diagnóstico para soporte">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="Exportar diagnóstico" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Grid.Row="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.TextoResumenRegistroFiltrado, Mode=OneWay}" />
                    <Border Grid.Row="4" Style="{StaticResource Tarjeta}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Padding="32,48"
                                Grid.RowSpan="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.MostrarEstadoVacioRegistro, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="40"
                                    Glyph="&#xE8A5;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Aún no hay actividad registrada" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Los eventos aparecerán aquí cuando ejecutes una sincronización o pulses Iniciar."
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Grid
                                x:Name="CabeceraRegistro"
                                Grid.Row="0"
                                ColumnSpacing="0"
                                Padding="10,6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.MostrarEstadoVacioRegistro, Mode=OneWay, Converter={StaticResource BoolAVis}, ConverterParameter=Invertir}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        x:Name="ColRegistroHora"
                                        Width="{x:Bind ViewModel.AnchoRegistroHora, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition
                                        x:Name="ColRegistroPar"
                                        Width="{x:Bind ViewModel.AnchoRegistroPar, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition
                                        x:Name="ColRegistroNivel"
                                        Width="{x:Bind ViewModel.AnchoRegistroNivel, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition
                                        x:Name="ColRegistroMensaje"
                                        Width="{x:Bind ViewModel.AnchoRegistroMensaje, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CabeceraColumna}" Text="Hora" />
                                <Border
                                    x:Name="SepRegistroHoraPar"
                                    Grid.Column="1"
                                    Style="{StaticResource SeparadorColumna}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CabeceraColumna}" Text="Par" />
                                <Border
                                    x:Name="SepRegistroParNivel"
                                    Grid.Column="3"
                                    Style="{StaticResource SeparadorColumna}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource CabeceraColumna}" Text="Nivel" />
                                <Border
                                    x:Name="SepRegistroNivelMensaje"
                                    Grid.Column="5"
                                    Style="{StaticResource SeparadorColumna}" />
                                <TextBlock Grid.Column="6" Style="{StaticResource CabeceraColumna}" Text="Mensaje" />
                            </Grid>
                            <ListView
                                x:Name="ListaRegistro"
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.LineasRegistro, Mode=OneWay}"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.MostrarEstadoVacioRegistro, Mode=OneWay, Converter={StaticResource BoolAVis}, ConverterParameter=Invertir}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LineaRegistroViewModel">
                                    <Grid
                                        Padding="10,4"
                                        Background="{Binding Nivel, Converter={StaticResource NivelRegistroBrush}, ConverterParameter=Fondo}"
                                        ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoRegistroHora, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoRegistroPar, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoRegistroNivel, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{Binding ElementName=PaginaPrincipal, Path=ViewModel.AnchoRegistroMensaje, Mode=OneWay, Converter={StaticResource AnchoColumnaPx}}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{Binding Nivel, Converter={StaticResource NivelRegistroBrush}, ConverterParameter=Mensaje}"
                                            Text="{Binding Hora}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="12"
                                            Foreground="{Binding Nivel, Converter={StaticResource NivelRegistroBrush}, ConverterParameter=Mensaje}"
                                            Text="{Binding Par}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Par}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Nivel, Converter={StaticResource NivelRegistroBrush}, ConverterParameter=Nivel}"
                                            Text="{Binding Nivel}" />
                                        <TextBlock
                                            Grid.Column="6"
                                            FontSize="12"
                                            Foreground="{Binding Nivel, Converter={StaticResource NivelRegistroBrush}, ConverterParameter=Mensaje}"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding MensajeLegible}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding TextoCompleto}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ESTADÍSTICAS -->
                <ScrollViewer
                    x:Name="PanelEstadisticas"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="960">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource TituloSeccion}" Text="Estadísticas" />
                            <TextBlock
                                Style="{StaticResource SubtituloSeccion}"
                                Text="Transferencia, cola de trabajo, recursos del demonio y desglose por par." />
                        </StackPanel>

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Estadisticas.MostrarAvisoSinDatos, Mode=OneWay}"
                            IsClosable="False"
                            Message="{x:Bind ViewModel.Estadisticas.TextoAvisoSinDatos, Mode=OneWay}"
                            Severity="Informational"
                            Title="Sin telemetría en vivo" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Tiempo de sesión" />
                                    <TextBlock
                                        Style="{StaticResource ValorMetrica}"
                                        Text="{x:Bind ViewModel.Estadisticas.TextoTiempoSesion, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Text="{x:Bind ViewModel.Estadisticas.TextoInicioSesion, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Proceso demonio" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="PID" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoPid, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Última actualización" />
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoUltimaActualizacion, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Escritura en disco" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Datos copiados" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoBytesEscritos, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Velocidad media" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoVelocidadEscritura, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Archivos" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Copiados" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoArchivosCopiados, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Errores" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoErrores, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Dup. evitados" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoDuplicadosEvitados, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Cola y copias" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Pendientes" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoColaPendiente, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Hidratando" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoHidrataciones, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Copiando ahora" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoCopiasActivas, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Recursos del demonio" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="RAM (working set)" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoMemoriaDemonio, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="CPU" />
                                            <TextBlock
                                                Style="{StaticResource ValorMetrica}"
                                                FontSize="18"
                                                Text="{x:Bind ViewModel.Estadisticas.TextoCpuDemonio, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Tarjeta}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource EtiquetaMetrica}" Text="Registro en disco" />
                                    <TextBlock
                                        Style="{StaticResource ValorMetrica}"
                                        FontSize="18"
                                        Text="{x:Bind ViewModel.Estadisticas.TextoTamanoRegistro, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Desglose por par" />
                            <Border Style="{StaticResource Tarjeta}" Padding="0">
                                <StackPanel>
                                    <Grid
                                        ColumnSpacing="8"
                                        Padding="8,6"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CabeceraColumna}" Text="Nombre" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource CabeceraColumna}" Text="Estado" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CabeceraColumna}" Text="Copiados" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource CabeceraColumna}" Text="Errores" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource CabeceraColumna}" Text="Última sync." />
                                    </Grid>
                                    <ListView
                                    ItemsSource="{x:Bind ViewModel.Estadisticas.Pares, Mode=OneWay}"
                                    IsHitTestVisible="False"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:EstadisticaParItemViewModel">
                                            <Grid ColumnSpacing="8" Padding="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource CeldaFila}" Text="{Binding Nombre}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource CeldaFila}" Text="{Binding Estado}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource CeldaFila}" Text="{Binding Copiados}" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource CeldaFila}" Text="{Binding Errores}" />
                                                <TextBlock Grid.Column="4" Style="{StaticResource CeldaFila}" Text="{Binding UltimaSincronizacion}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Historial de sesiones" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Últimas ejecuciones del demonio en este perfil (se guardan al detener)."
                                TextWrapping="WrapWholeWords" />
                            <Border Style="{StaticResource Tarjeta}" Padding="0">
                                <StackPanel>
                                    <StackPanel
                                        Padding="32,24"
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.MostrarHistorialSesionesVacio, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Aún no hay sesiones registradas"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.HistorialSesiones, Mode=OneWay}"
                                        IsHitTestVisible="False"
                                        SelectionMode="None"
                                        Visibility="{x:Bind ViewModel.MostrarHistorialSesionesVacio, Mode=OneWay, Converter={StaticResource BoolAVis}, ConverterParameter=Invertir}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:HistorialSesionViewModel">
                                                <Grid ColumnSpacing="12" Padding="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Style="{StaticResource CeldaFila}"
                                                        Text="{Binding TextoInicio}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource CeldaFila}"
                                                        Text="{Binding TextoDuracion}" />
                                                    <Border
                                                        Grid.Column="2"
                                                        Style="{StaticResource ChipEstado}"
                                                        Background="{Binding ClaveEstado, Converter={StaticResource EstadoParBrush}, ConverterParameter=Fondo}">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding ClaveEstado, Converter={StaticResource EstadoParBrush}, ConverterParameter=Texto}"
                                                            Text="{Binding TextoEstado}" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Style="{StaticResource CeldaFila}"
                                                        Text="{Binding TextoResumen}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- GUÍA DE REFERENCIA -->
                <ScrollViewer
                    x:Name="PanelGuia"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="920" Padding="0,0,8,24">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource TituloSeccion}" Text="Guía de referencia" />
                            <TextBlock
                                Style="{StaticResource SubtituloSeccion}"
                                Text="Empieza por «Guía rápida» y «¿Qué NO hace?». Expande cada apartado; el texto es seleccionable." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="IrAInicioAsistente_Click" Content="Abrir asistente" />
                            <Button Click="IrASincronizacion_Click" Content="Ir a sincronización" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SeccionesGuia, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SeccionGuiaViewModel">
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Titulo}" />
                                        </Expander.Header>
                                        <TextBlock
                                            Margin="0,8,0,4"
                                            IsTextSelectionEnabled="True"
                                            LineHeight="22"
                                            Text="{x:Bind Cuerpo}"
                                            TextWrapping="WrapWholeWords" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <!-- AJUSTES AVANZADOS (icono engranaje del NavigationView) -->
                <ScrollViewer
                    x:Name="PanelAjustes"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="560">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource TituloSeccion}" Text="Ajustes avanzados" />
                            <TextBlock
                                Style="{StaticResource SubtituloSeccion}"
                                Text="Parámetros del motor de sincronización. Requieren Guardar y reiniciar o Recargar el demonio." />
                        </StackPanel>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Sistema" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Registra SManager en el inicio de Windows (solo tu usuario, sin permisos de administrador)."
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    Header="Iniciar SManager al encender Windows"
                                    IsOn="{x:Bind ViewModel.AutoInicioHabilitado, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Iniciar oculto en la bandeja del sistema"
                                    IsEnabled="{x:Bind ViewModel.AutoInicioHabilitado, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.AutoInicioMinimizado, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Iniciar sincronización al encender Windows"
                                    IsEnabled="{x:Bind ViewModel.AutoInicioHabilitado, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.AutoInicioIniciarDemonio, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Ayuda y primer uso" />
                                <ToggleSwitch
                                    Header="Mostrar consejos contextuales"
                                    IsOn="{x:Bind ViewModel.MostrarConsejosContextuales, Mode=TwoWay}"
                                    OffContent="No"
                                    OnContent="Sí" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.AbrirAsistenteOnboardingCommand}"
                                    Content="Abrir asistente de configuración" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Click="RestablecerConsejos_Click"
                                    Content="Volver a mostrar consejos" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Bandeja y notificaciones" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Mantén SManager activo en segundo plano. Al cerrar la ventana puedes ocultarla en la bandeja del sistema en lugar de salir."
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    Header="Icono en la bandeja del sistema"
                                    IsOn="{x:Bind ViewModel.BandejaHabilitada, Mode=TwoWay}"
                                    OffContent="No"
                                    OnContent="Sí" />
                                <ToggleSwitch
                                    Header="Minimizar a la bandeja al cerrar la ventana"
                                    IsEnabled="{x:Bind ViewModel.BandejaHabilitada, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.MinimizarABandejaAlCerrar, Mode=TwoWay}"
                                    OffContent="Salir"
                                    OnContent="Ocultar" />
                                <ToggleSwitch
                                    Header="Notificaciones de Windows"
                                    IsOn="{x:Bind ViewModel.NotificacionesHabilitadas, Mode=TwoWay}"
                                    OffContent="No"
                                    OnContent="Sí" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Interfaz" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Modo básico oculta Monitor, Registro y Estadísticas. El tema claro/oscuro puede seguir al sistema o fijarse manualmente."
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    Header="Modo avanzado"
                                    IsOn="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=TwoWay}"
                                    OffContent="Básico"
                                    OnContent="Avanzado" />
                                <ComboBox
                                    Header="Tema de la aplicación"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.OpcionesTema, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.TemaAplicacion, Mode=TwoWay}" />
                                <ComboBox
                                    Header="Idioma"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="False"
                                    ItemsSource="{x:Bind ViewModel.OpcionesIdioma, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.IdiomaUiEtiqueta, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Más idiomas en futuras versiones" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource Tarjeta}"
                            Visibility="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Margin="0,0,0,0" Text="Vigilancia" />
                                <NumberBox Header="Polling de seguridad (segundos)" Minimum="30" Maximum="3600" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.IntervaloPollingSegundos, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                <NumberBox Header="Estabilidad del archivo (segundos)" Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.SegundosEstabilidadArchivo, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource Tarjeta}"
                            Visibility="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Margin="0,0,0,0" Text="Rendimiento" />
                                <NumberBox Header="Copiadores en paralelo" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.NumCopiadoresParalelos, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                <NumberBox Header="Hidratadores en paralelo" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.NumHidratadoresParalelos, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                <NumberBox Header="Timeout hidratación (segundos)" Minimum="30" Maximum="3600" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.TimeoutHidratacionSegundos, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                <NumberBox Header="Publicación de estado (ms)" Minimum="200" Maximum="5000" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.IntervaloPublicacionEstadoMs, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource Tarjeta}"
                            Visibility="{x:Bind ViewModel.ModoInterfazAvanzado, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Text="Archivo de configuración" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Por defecto cada perfil usa su JSON en Perfiles configuracion. Puedes apuntar el perfil a otro archivo .json en cualquier ruta."
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.RutaConfiguracionPorDefecto, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.RutaConfiguracion, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.TextoModoRutaConfig, Mode=OneWay}" />
                                <StackPanel Spacing="8">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ElegirRutaConfigExistenteCommand}"
                                        Content="Abrir JSON existente…"
                                        IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.CrearRutaConfigPersonalizadaCommand}"
                                        Content="Guardar como…"
                                        IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.RestablecerRutaConfigPorDefectoCommand}"
                                        Content="Usar ubicación por defecto"
                                        IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource EtiquetaGrupo}" Margin="0,0,0,0" Text="Mantenimiento del perfil" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Vacía el log, la telemetría (Monitor, Registro, Estadísticas) y reinicia los contadores del perfil. El demonio debe estar detenido."
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.EliminarPerfilCommand}"
                                    IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}"
                                    ToolTipService.ToolTip="Eliminar el perfil activo y sus datos en disco">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Delete" />
                                        <TextBlock Text="Eliminar perfil" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.LimpiarDatosPerfilCommand}"
                                    IsEnabled="{x:Bind ViewModel.PuedeEditarConfig, Mode=OneWay}"
                                    ToolTipService.ToolTip="Limpiar log, telemetría y contadores del perfil activo">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Clear" />
                                        <TextBlock Text="Limpiar datos del perfil" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <Grid
                Grid.RowSpan="3"
                Background="#B3000000"
                Visibility="{x:Bind ViewModel.MostrarAsistenteOnboarding, Mode=OneWay, Converter={StaticResource BoolAVis}}">
                <vistas:AsistenteOnboardingControl
                    x:Name="ControlAsistente"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24" />
            </Grid>
        </Grid>
    </NavigationView>

        <TeachingTip
            x:Name="ConsejoIniciar"
            Title="Iniciar sincronización"
            Subtitle="Cuando tengas al menos un par activo, pulsa Iniciar. SManager copiará desde origen hacia destino y seguirá vigilando cambios."
            Target="{x:Bind BotonIniciarSync}"
            IsOpen="{x:Bind ViewModel.ConsejoIniciarAbierto, Mode=TwoWay}"
            CloseButtonClick="ConsejoIniciar_Cerrado" />

        <TeachingTip
            x:Name="ConsejoAnalizar"
            Title="Analizar antes de copiar"
            Subtitle="Compara origen y destino sin modificar archivos. Ideal la primera vez o antes de una copia grande."
            Target="{x:Bind BotonAnalizarCambios}"
            IsOpen="{x:Bind ViewModel.ConsejoAnalizarAbierto, Mode=TwoWay}"
            CloseButtonClick="ConsejoAnalizar_Cerrado" />

        <!-- Panel oculto capturado como imagen (mismo aspecto que tarjetas de Sincronización) -->
        <Grid
            x:Name="PanelExportacionParesActivos"
            Visibility="Collapsed"
            Width="760"
            Margin="-24000,0,0,0"
            Padding="24"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TituloSeccion}" Text="Pares de sincronización" />
                    <TextBlock Style="{StaticResource SubtituloSeccion}">
                        <Run Text="Perfil " />
                        <Run Text="{x:Bind ViewModel.TextoExportacionPerfil, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{x:Bind ViewModel.TextoExportacionFecha, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Style="{StaticResource SubtituloSeccion}"
                        Text="Pares en estado OK mientras el demonio sincroniza." />
                </StackPanel>

                <Border Style="{StaticResource Tarjeta}" Padding="12">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ParesExportacionImagen, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ParExportacionImagenViewModel">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Nombre, Mode=OneWay}" />
                                            <Border
                                                Style="{StaticResource ChipEstado}"
                                                Background="{x:Bind ClaveEstadoChip, Mode=OneWay, Converter={StaticResource EstadoParBrush}, ConverterParameter=Fondo}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind ClaveEstadoChip, Mode=OneWay, Converter={StaticResource EstadoParBrush}, ConverterParameter=Texto}"
                                                    Text="{x:Bind EtiquetaEstado, Mode=OneWay}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <Border
                                                Background="{StaticResource OrigenFondoBrush}"
                                                BorderBrush="{StaticResource OrigenAcentoBrush}"
                                                BorderThickness="0,0,0,2"
                                                CornerRadius="4"
                                                Padding="8,6">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource OrigenAcentoBrush}"
                                                        Text="Origen" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Text="{x:Bind RutaOrigen, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Glyph="&#xE74B;"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border
                                                Background="{StaticResource DestinoFondoBrush}"
                                                BorderBrush="{StaticResource DestinoAcentoBrush}"
                                                BorderThickness="0,0,0,2"
                                                CornerRadius="4"
                                                Padding="8,6">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource DestinoAcentoBrush}"
                                                        Text="Destino" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Text="{x:Bind RutaDestino, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind TextoTamanoDestino, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Copiados" />
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind TextoCopiados, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Errores" />
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind TextoErrores, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Estado" />
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Estado, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
