<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colores consistentes para origen (azul) y destino (verde) en toda la GUI -->
    <SolidColorBrush x:Key="OrigenFondoBrush" Color="#1A0078D4" />
    <SolidColorBrush x:Key="OrigenAcentoBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="DestinoFondoBrush" Color="#1A107C10" />
    <SolidColorBrush x:Key="DestinoAcentoBrush" Color="#107C10" />
</ResourceDictionary>
