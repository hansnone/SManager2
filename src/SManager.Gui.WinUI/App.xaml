<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SManager.Gui.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Recursos/RegistroTema.xaml" />
                <ResourceDictionary Source="Recursos/EstadoParTema.xaml" />
                <ResourceDictionary Source="Recursos/OrigenDestinoTema.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Paleta Azul Marino Sobrio (alineada con themes/sober-light.css) -->
            <Color x:Key="SystemAccentColor">#FF0F2942</Color>
            <Color x:Key="SystemAccentColorLight1">#FF1D4E89</Color>
            <Color x:Key="SystemAccentColorLight2">#FF2B6CB0</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0A1C2E</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0F2942" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF1D4E89" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF0A1C2E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
