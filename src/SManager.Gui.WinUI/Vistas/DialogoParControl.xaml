<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SManager.Gui.WinUI.Vistas.DialogoParControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SManager.Gui.WinUI.Models"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">

    <!-- MaxHeight: el ContentDialog limita la altura; el scroll deja ver exclusiones y toggles -->
    <ScrollViewer
        MaxHeight="520"
        HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Disabled">
        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
            <TextBlock
                x:Name="TextoAyuda"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Define origen, destino y filtros del par de sincronización."
                TextWrapping="WrapWholeWords" />

            <TextBox x:Name="CajaNombre" Header="Nombre" PlaceholderText="Nombre del par" />

            <!-- Ruta + botón en columna: evita recorte lateral del ContentDialog (~548 px) -->
            <StackPanel Spacing="6">
                <TextBox
                    x:Name="CajaOrigen"
                    Header="Carpeta origen"
                    PlaceholderText="Ruta de origen" />
                <Button
                    HorizontalAlignment="Left"
                    Click="BotonOrigen_Click"
                    Content="Examinar carpeta origen"
                    ToolTipService.ToolTip="Abrir el explorador de archivos" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBox
                    x:Name="CajaDestino"
                    Header="Carpeta destino"
                    PlaceholderText="Ruta de destino" />
                <Button
                    HorizontalAlignment="Left"
                    Click="BotonDestino_Click"
                    Content="Examinar carpeta destino"
                    ToolTipService.ToolTip="Abrir el explorador de archivos" />
            </StackPanel>

            <TextBox
                x:Name="CajaInclusion"
                Header="Copiar solo archivos que coincidan con"
                PlaceholderText="*"
                ToolTipService.ToolTip="Patrones glob separados por ;. Ejemplo: *.pdf;*.docx" />

            <Expander Header="Omitir archivos (editor visual)" IsExpanded="True">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Patrones glob separados por regla. Ejemplos: *.tmp, ~$*, node_modules"
                        TextWrapping="WrapWholeWords" />
                    <ListView
                        x:Name="ListaReglasExclusion"
                        MaxHeight="160"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReglaFiltroViewModel">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        PlaceholderText="*.tmp"
                                        Text="{x:Bind Patron, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Click="BotonEliminarRegla_Click" Tag="{x:Bind}">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="BotonAnadirRegla_Click" Content="Añadir regla" />
                        <Button Click="BotonProbarFiltros_Click" Content="Probar filtros" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TextoResultadoPruebaFiltros"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Expander>

            <ComboBox
                x:Name="DesplegableModo"
                Header="Modo de sincronización"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="DesplegableModo_SelectionChanged">
                <ComboBoxItem Content="Acumulativo sin borrado (Principal / Predeterminado)" Tag="0" />
                <ComboBoxItem Content="Acumulativo con borrado en origen (Requiere Admin Local)" Tag="1" />
                <ComboBoxItem Content="Espejo — Mirror (Sincronización total idéntica A -> B)" Tag="2" />
            </ComboBox>
            <TextBlock
                x:Name="TextoExplicacionModo"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Guarda todos los archivos de A en B. No borra nada en B ni en A aunque se eliminen archivos en el Origen."
                TextWrapping="WrapWholeWords" />

            <StackPanel Orientation="Horizontal" Spacing="24">
                <ToggleSwitch x:Name="InterruptorActivo" Header="Activo" OnContent="Sí" OffContent="No" />
                <ToggleSwitch x:Name="InterruptorPausa" Header="Pausado" OnContent="Sí" OffContent="No" />
            </StackPanel>

            <NumberBox
                x:Name="CajaPollingPar"
                Header="Barrido de seguridad (segundos)"
                Minimum="0"
                Maximum="3600"
                SpinButtonPlacementMode="Inline"
                SmallChange="30"
                LargeChange="60"
                ToolTipService.ToolTip="0 = usar el intervalo global de Ajustes. Mínimo efectivo: 30 s." />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Red de seguridad si el vigilante de archivos pierde eventos. Los cambios normales los detecta el FileSystemWatcher en segundos."
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
